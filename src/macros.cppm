// mcpplibs.mwrap.freetype.macros — the macros of FreeType's public headers (a
// named module cannot export a macro), under their original names in
// mcpplibs::mwrap::freetype::macros:
//
//   - :constants (generated by tools/gen_exports.py): every constant macro as
//     an `inline constexpr` of its macro's type — FT_LOAD_*, FT_FACE_FLAG_*,
//     FT_STYLE_FLAG_*, FT_OPEN_*, FT_OUTLINE_*, FT_CURVE_TAG_*, FT_RASTER_FLAG_*,
//     FT_FSTYPE_*, FT_PARAM_TAG_*, TTAG_*, TT_PLATFORM_* / TT_MS_ID_* / TT_NAME_ID_*
//     …, FREETYPE_MAJOR / MINOR / PATCH, the legacy ft_* spellings; the macros
//     naming a type (FT_Outline_MoveTo_Func …) as aliases; FT_Err_* and
//     FT_Mod_Err_* as FT_Error constants.
//   - :functions: the computation macros as functions with the macros'
//     semantics — FT_HAS_* / FT_IS_* of a face, FT_LOAD_TARGET_,
//     FT_LOAD_TARGET_MODE, FT_MAKE_TAG, FT_CURVE_TAG, FT_BOOL, FT_ERROR_BASE,
//     FT_ERROR_MODULE, FT_IS_EMPTY, FTC_IMAGE_TYPE_COMPARE, FT_FACE_DRIVER_NAME.
//
// The macros neither can be stay macros in <mwrap/freetype/macros.hpp>;
// tools/check_exports.py accounts for every macro.
export module mcpplibs.mwrap.freetype.macros;

export import :constants;
export import :functions;
